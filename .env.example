# Trippl — environment variables (example).
# Copy this file to `.env` (gitignored) and fill in real values. Never commit secrets.
#
# Only CLIENT-side vars belong here — the EXPO_PUBLIC_* prefix inlines them into the
# app bundle (via process.env + app config `extra`; see app.config.ts + lib/supabase.ts).
# SERVER secrets (ANTHROPIC_API_KEY, GOOGLE_PLACES_API_KEY, the Supabase service_role
# key) live ONLY in Supabase Edge Function secrets — never here, never in the app.

# --- Supabase (client) ---
# The anon key is a PUBLISHABLE client key protected by Row-Level Security — it is
# NOT a server secret. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Web origin for invite links (optional) ---
# The real deployed origin, e.g. https://trippl.vercel.app. On the web build we fall
# back to window.location.origin, so this mainly matters for links shared from the
# iOS/Android apps.
# EXPO_PUBLIC_WEB_URL=https://your-app.vercel.app

# --- EAS (optional locally) ---
# Printed by `eas init`. Enables Expo push tokens + EAS Update. In EAS cloud builds
# it is injected automatically, so you only need it for local / Expo Go testing.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# NOTE: for PRODUCTION builds, set the values above per-environment in EAS
# (dashboard, or `eas env:create --environment production …`) rather than committing
# them — the build profiles in eas.json pull the matching environment. See docs/deploy.md.
