# AppName — environment variables (example).
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
#
# Supabase (client-side). The EXPO_PUBLIC_ prefix makes these available in the app
# bundle via process.env and app config `extra` (see app.config.ts + lib/supabase.ts).
# The anon key is a publishable client key protected by Row-Level Security — it is NOT
# a server secret. Do not put the Supabase service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
